{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "REST API of the Master App mobile app and admin panel",
    "title" : "Master App API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "tags" : [ {
    "description" : "Reference data: cities and categories",
    "name" : "catalog"
  } ],
  "paths" : {
    "/api/v1/categories" : {
      "get" : {
        "operationId" : "listCategories",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CategoryResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Service categories",
        "tags" : [ "catalog" ]
      }
    },
    "/api/v1/cities" : {
      "get" : {
        "operationId" : "listCities",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CityResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "security" : [ ],
        "summary" : "Cities where the platform works",
        "tags" : [ "catalog" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApiProblem" : {
        "properties" : {
          "code" : {
            "$ref" : "#/components/schemas/ErrorCode"
          },
          "detail" : {
            "type" : "string",
            "description" : "human-readable; do not branch on it"
          },
          "instance" : {
            "type" : "string",
            "description" : "the request path"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "description" : "absent while it is about:blank"
          }
        },
        "required" : [ "code", "detail", "instance", "status", "title" ]
      },
      "CategoryResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "nameKk" : {
            "type" : "string"
          },
          "nameRu" : {
            "type" : "string"
          },
          "requiresReport" : {
            "type" : "boolean",
            "description" : "an order completes only after an inspection report is published"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "nameKk", "nameRu", "requiresReport", "slug" ]
      },
      "CityResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "nameKk" : {
            "type" : "string"
          },
          "nameRu" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "nameKk", "nameRu", "slug" ]
      },
      "ErrorCode" : {
        "type" : "string",
        "description" : "machine-readable reason of an error response",
        "enum" : [ "INVALID_REQUEST", "AUTH_REQUIRED", "FORBIDDEN", "NOT_FOUND", "INTERNAL_ERROR" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
