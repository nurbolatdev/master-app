# Copy to .env (never commit it). Local runs need nothing: infra starts from ../../infra/docker-compose.yml.
PORT=8080
# HS256 key for access tokens, at least 32 characters. Local default is in application.yml.
JWT_SECRET=
# Comma-separated origins of the admin panel (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Demo server only
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
